@{
    ViewBag.Title = "Manager - Bookings";
    ViewBag.Active = "Bookings";
}
<div class="manager-header">
    <h2>Manager dashboard</h2>
    <p>View all bookings, or book a lesson on behalf of a student.</p>
</div>

@Html.Partial("_ManagerNav")

<div class="manager-panel">
    <div class="manager-panel-header">
        <h3>Bookings</h3>
        <button type="button" class="btn-accent" data-toggle="modal" data-target="#addBookingModal">+ New booking</button>
    </div>

    <div class="search-bar">
        <input type="text" class="form-control-custom" placeholder="Search bookings by student, instructor, or date" />
    </div>

    <div class="table-placeholder">
        Bookings table will go here (student, instructor, date, time, status).
    </div>
</div>

<!-- New Booking Modal -->
<div class="modal fade" id="addBookingModal" tabindex="-1" role="dialog" aria-labelledby="addBookingModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-content-custom">
            @using (Html.BeginForm("AddBooking", "Manager", FormMethod.Post))
            {
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="addBookingModalLabel">Book a lesson</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group-custom">
                        <label>Student</label>
                        <input type="text" name="StudentName" class="form-control-custom" placeholder="Search or enter student name" />
                    </div>
                    <div class="form-group-custom">
                        <label>Instructor</label>
                        <input type="text" name="InstructorName" class="form-control-custom" placeholder="Search or enter instructor name" />
                    </div>
                    <div class="form-group-custom">
                        <label>Date</label>
                        <input type="date" name="BookingDate" class="form-control-custom" />
                    </div>
                    <div class="form-group-custom">
                        <label>Time</label>
                        <input type="time" name="BookingTime" class="form-control-custom" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-outline-accent" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-accent">Save booking</button>
                </div>
            }
        </div>
    </div>
</div>