@{
    ViewBag.Title = "Receptionist - Students";
    ViewBag.Active = "Students";
}
<div class="manager-header">
    <h2>Receptionist dashboard</h2>
    <p>View registered students and register new ones.</p>
</div>

@Html.Partial("_ReceptionistNav")

<div class="manager-panel">
    <div class="manager-panel-header">
        <h3>Students</h3>
        <button type="button" class="btn-accent" data-toggle="modal" data-target="#addStudentModal">+ Add student</button>
    </div>

    <div class="search-bar">
        <input type="text" class="form-control-custom" placeholder="Search students by name, email, or phone" />
    </div>

    <div class="table-placeholder">
        Students table will go here (name, contact details, ID number, registered lessons).
    </div>
</div>

<!-- Add Student Modal -->
<div class="modal fade" id="addStudentModal" tabindex="-1" role="dialog" aria-labelledby="addStudentModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-content-custom">
            @using (Html.BeginForm("AddStudent", "Receptionist", FormMethod.Post))
            {
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="addStudentModalLabel">Register new student</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group-custom">
                        <label>Full name</label>
                        <input type="text" name="FullName" class="form-control-custom" placeholder="Enter full name" />
                    </div>
                    <div class="form-group-custom">
                        <label>Email</label>
                        <input type="email" name="Email" class="form-control-custom" placeholder="Enter email address" />
                    </div>
                    <div class="form-group-custom">
                        <label>Phone number</label>
                        <input type="text" name="Phone" class="form-control-custom" placeholder="Enter phone number" />
                    </div>
                    <div class="form-group-custom">
                        <label>ID number</label>
                        <input type="text" name="IdNumber" class="form-control-custom" placeholder="Enter ID number" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-outline-accent" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-accent">Save student</button>
                </div>
            }
        </div>
    </div>
</div>
