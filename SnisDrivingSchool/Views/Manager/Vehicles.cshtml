@{
    ViewBag.Title = "Manager - Vehicles";
    ViewBag.Active = "Vehicles";
}
<div class="manager-header">
    <h2>Manager dashboard</h2>
    <p>Manage the driving school's vehicle fleet.</p>
</div>

@Html.Partial("_ManagerNav")

<div class="manager-panel">
    <div class="manager-panel-header">
        <h3>Vehicles</h3>
        <button type="button" class="btn-accent" data-toggle="modal" data-target="#addVehicleModal">+ Add vehicle</button>
    </div>

    <div class="search-bar">
        <input type="text" class="form-control-custom" placeholder="Search vehicles by make, model, or registration" />
    </div>

    <div class="table-placeholder">
        Vehicles table will go here (make, model, registration, assigned instructor, status).
    </div>
</div>

<!-- Add Vehicle Modal -->
<div class="modal fade" id="addVehicleModal" tabindex="-1" role="dialog" aria-labelledby="addVehicleModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-content-custom">
            @using (Html.BeginForm("AddVehicle", "Manager", FormMethod.Post))
            {
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="addVehicleModalLabel">Add vehicle</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group-custom">
                        <label>Make</label>
                        <input type="text" name="Make" class="form-control-custom" placeholder="Enter vehicle make" />
                    </div>
                    <div class="form-group-custom">
                        <label>Model</label>
                        <input type="text" name="Model" class="form-control-custom" placeholder="Enter vehicle model" />
                    </div>
                    <div class="form-group-custom">
                        <label>Registration number</label>
                        <input type="text" name="Registration" class="form-control-custom" placeholder="Enter registration number" />
                    </div>
                    <div class="form-group-custom">
                        <label>Assigned instructor</label>
                        <input type="text" name="AssignedInstructor" class="form-control-custom" placeholder="Enter instructor name (optional)" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-outline-accent" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-accent">Save vehicle</button>
                </div>
            }
        </div>
    </div>
</div>
