@{
    ViewBag.Title = "Login";
}

<div class="login-wrapper">
    <div class="login-card">
        <h2>Welcome Back</h2>
        <p class="login-subtext">Log in to access your dashboard</p>

        @if (ViewBag.Error != null)
        {
            <div class="login-error">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post))
        {
            <div class="form-group-custom">
                <label>Username</label>
                <input type="text" name="username" class="form-control-custom" placeholder="e.g. manager, student..." />
            </div>
            <div class="form-group-custom">
                <label>Password</label>
                <input type="password" name="password" class="form-control-custom" placeholder="Password" />
            </div>
            <button type="submit" class="btn-accent btn-block-custom">Log In</button>
        }

        <p class="login-footer">Don't have an account? @Html.ActionLink("Register here", "Register", "Account")</p>
    </div>
</div>