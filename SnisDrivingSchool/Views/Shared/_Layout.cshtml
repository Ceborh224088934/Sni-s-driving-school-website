<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sni's Driving School</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-inverse navbar-fixed-top">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                @Html.ActionLink("Sni's Driving School", "Index", "Home", null, new { @class = "navbar-brand" })
            </div>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li>@Html.ActionLink("About", "About", "Home")</li>
                    <li>@Html.ActionLink("Contact", "Contact", "Home")</li>

                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                            Accounts <span class="caret"></span>
                        </a>
                        <ul class="dropdown-menu">
                            <li>@Html.ActionLink("Student", "Login", "Account", new { role = "Student" }, null)</li>
                            <li>@Html.ActionLink("Instructor", "Login", "Account", new { role = "Instructor" }, null)</li>
                            <li>@Html.ActionLink("Manager", "Login", "Account", new { role = "Manager" }, null)</li>
                            <li>@Html.ActionLink("Receptionist", "Login", "Account", new { role = "Receptionist" }, null)</li>
                        </ul>
                    </li>

                    <li>@Html.ActionLink("Rate and Reviews", "RateAndReviews", "Home")</li>
                </ul>
                <ul class="nav navbar-nav navbar-right">
                    @if (Session["Role"] != null)
                    {
                        <li><a href="#">@Session["Role"]</a></li>
                        <li>@Html.ActionLink("Log Out", "Logout", "Account")</li>
                        <li>@Html.ActionLink(" Profile", "Profile", "Account")</li>
                    }
                    else
                    {<li>@Html.ActionLink("Log In", "Login", "Account")</li>
                        <li>@Html.ActionLink("Register", "Register", "Account")</li>
                      
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content" style="padding-top: 80px;">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Sni's Driving School</p>
        </footer>
    </div>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>