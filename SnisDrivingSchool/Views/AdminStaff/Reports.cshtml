@{
    ViewBag.Title = "Admin - Reports";
    ViewBag.Active = "Reports";
}
<div class="manager-header">
    <h2>Admin dashboard</h2>
    <p>Review activity across the school and export reports.</p>
</div>

@Html.Partial("_AdminStaffNav")

<div class="manager-panel">
    <div class="manager-panel-header">
        <h3>Reports</h3>
        <button type="button" class="btn-accent">Export report</button>
    </div>

    <div class="search-bar">
        <input type="date" class="form-control-custom" placeholder="From date" style="max-width:190px; display:inline-block; margin-right:10px;" />
        <input type="date" class="form-control-custom" placeholder="To date" style="max-width:190px; display:inline-block;" />
    </div>

    <div class="table-placeholder">
        Report data will go here (new registrations, staff activity, attendance).
    </div>
</div>
